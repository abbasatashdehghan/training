function launchConfetti(){const box=document.getElementById('confettiBox');
for(let i=0;i<100;i++){const c=document.createElement('div');
c.style.cssText=`position:absolute;top:-10px;left:${Math.random()*100}%;width:${6+Math.random()*8}px;height:${6+Math.random()*8}px;background:${['#DD1D21','#009EB4','#EB8705','#008443','#641964','#FBCE07'][Math.floor(Math.random()*6)]};border-radius:${Math.random()>0.5?'50%':'2px'};animation:confFall ${2+Math.random()*3}s linear forwards;opacity:0.9;`;
box.appendChild(c);}
if(!document.getElementById('confStyle')){const style=document.createElement('style');style.id='confStyle';
style.textContent=`@keyframes confFall{0%{transform:translateY(0) rotate(0deg);opacity:1}100%{transform:translateY(${window.innerHeight+50}px) rotate(${720}deg);opacity:0}}`;
document.head.appendChild(style);}
setTimeout(()=>{box.innerHTML='';},5000);}

showSection(0);

// Animation loop for sandbox raindrops
(function animLoop(){
const now=performance.now();
if(currentSection===6&&s7Data&&s7Dots.length>0){
const active=s7Dots.filter(d=>(now-d.born-d.delay)/1000<3);
if(active.length>0)drawS7();
s7Dots=s7Dots.filter(d=>(now-d.born-d.delay)/1000<5);}
requestAnimationFrame(animLoop);})();

window.addEventListener('resize',()=>{
if(currentSection===0&&s1Inited)drawS1();if(currentSection===1&&s2Inited)drawS2();
if(currentSection===2&&s3Inited)drawS3();if(currentSection===3&&s4Inited)drawS4();
if(currentSection===5&&s6Inited)drawS6();if(currentSection===6&&s7Data)drawS7();});
</script>
</body>
